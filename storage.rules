rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // TEMPORAL: mientras el login de /admin sea hardcodeado (sin Firebase
    // Auth en el navegador), no hay "request.auth" para restringir la
    // escritura por identidad. Queda abierta a propósito. Cuando se vuelva
    // a habilitar Firebase Auth para el admin, restaurar:
    //   allow write: if request.auth != null;
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
