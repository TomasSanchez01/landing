rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública (imágenes/videos de productos se muestran en el sitio).
    // Escritura solo para el admin autenticado (único usuario que puede loguearse).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
